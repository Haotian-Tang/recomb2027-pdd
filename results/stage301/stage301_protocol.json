 "question": "Does the frozen structural localisation transport to the eps-tolerant problem, and if so how far does it move the reach of Theta_k?",
 "decision_rules": {
  "validation": "A localised Theta_k must equal the exhaustive Theta_k EXACTLY (rational equality) on every case where both run.  Any disagreement stops the stage and is reported.",
  "screen_contract": "A screen may only be used after a written proof that it is a necessary condition for theta(S) <= eps, and after the validation arm passes.",
  "reading": "If min theta over survivors <= eps the localised value IS Theta_k; otherwise the run certifies Theta_k > eps only.",
  "vacuity": "Pruning is reported as supports visited / C(|E|, k); a ratio of 1.0 is reported as vacuous, not as a success."
 },
 "screens": {
  "S1": "NEG(eps) = {v : b(v) < -tau} must lie in N[Sigma]",
  "S2": "POS(eps) = {v : b(v) >  tau} minus N[Sigma] must be covered by the atoms of the support; at most 2k of them",
  "S3": "h(r) - d_r <= 2 eps at every observed leaf",
  "S4": "Y >= -eps (|R| - 1)",
  "S5": "mass-weighted mean projection from leaf s onto the s-r path is at most rho = (d(r,s) - (d_r - d_s))/2 + eps",
  "tau": "tau_eps(v) = sum_{u~v} min(eps / l_uv, 1)",
  "anchors": "UNRELAXED {v : b(v) > 0}; relaxing the anchor set would be unsound (the proof gives b(v*) > 0 strictly)"
 },
